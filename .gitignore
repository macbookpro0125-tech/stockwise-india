node_modules
.env
*.local
.DS_Store

# Full-market fetch output — large, regenerated by running fetch-market.js,
# not source
data/market/
data/app.db
data/test.db
# Daily copies of app.db (server/backup.js) — accounts, never committed
data/backups/
# Any other copy of a database (e.g. the one db.js takes before an upgrade)
data/*.db*
*.db.before-*

# Daily prices and the snapshot built from them — regenerated by
# build-snapshot.js
data/prices/
data/market-snapshot.json

# Background jobs' bookkeeping (last check for new results)
data/jobs-state.json
# Installed timestamp for the latest live market-data pack
data/data-pack-state.json

# Past quarters' shareholding, cached as stock pages are opened
data/shareholding/

# The Performance tab's record of each strategy's picks — written as the app
# runs, so it's data, not source
data/performance-snapshots.json
# …and the monthly research-score cohorts (performance.js)
data/research-score-cohorts.json

# Production build output
dist/

# Company logos fetched from their own websites (server/logos.js)
data/logos/

# Playwright output (npm run e2e)
test-results/
playwright-report/

# Android signing keys live in ~/.jocular, never here
*.jks
*.keystore
upload-keystore.properties

# The signed app file for Play (replica/launch/play-listing.md); rebuilt, not kept in git
replica/launch/release/

# Firebase settings for the Android app (download from the Firebase console; kept out of git)
android/app/google-services.json

# Users' reviews of the app this one was compared with, quoted word for word
# with links that name it: research kept on this computer, not published
replica/reviews.csv
